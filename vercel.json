{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/proxyharvest", "destination": "/index.html" },
    { "source": "/proxyharvest.html", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    }
  ]
}
